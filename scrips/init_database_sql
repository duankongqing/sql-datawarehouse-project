/*
=============================================================
创建数据仓库的 Bronze、Silver、Gold 三层
=============================================================

脚本用途：

    本脚本用于创建数据仓库的 Bronze（铜层）、
    Silver（银层）和 Gold（金层）。

    如果这些数据库已经存在，脚本会先删除旧数据库，
    然后重新创建。

    注意：
    执行本脚本会删除原有的 Bronze、Silver、Gold
    数据库中的所有数据。

警告：

    如果数据库已经存在，执行本脚本会永久删除其中的所有数据。
    请谨慎执行，并确保重要数据已经做好备份。

=============================================================
*/


-- ==========================================================
-- 删除并重新创建 Bronze（铜层）
-- ==========================================================

-- 如果 Bronze 数据库已经存在，则删除它
DROP DATABASE IF EXISTS bronze;

-- 创建 Bronze 数据库
CREATE DATABASE bronze
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_0900_ai_ci;


-- ==========================================================
-- 删除并重新创建 Silver（银层）
-- ==========================================================

-- 如果 Silver 数据库已经存在，则删除它
DROP DATABASE IF EXISTS silver;

-- 创建 Silver 数据库
CREATE DATABASE silver
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_0900_ai_ci;


-- ==========================================================
-- 删除并重新创建 Gold（金层）
-- ==========================================================

-- 如果 Gold 数据库已经存在，则删除它
DROP DATABASE IF EXISTS gold;

-- 创建 Gold 数据库
CREATE DATABASE gold
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_0900_ai_ci;
